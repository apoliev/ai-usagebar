#: prefs.js:149
msgid "Mid"
msgstr "Moyen"

#: prefs.js:150
msgid "High"
msgstr "Élevé"

#: prefs.js:151
msgid "Critical"
msgstr "Critique"

#: prefs.js:155
msgid "Notifications"
